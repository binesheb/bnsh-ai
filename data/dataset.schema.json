{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIV Dataset Manifest",
  "type": "object",
  "required": ["id", "version", "source", "license", "languages"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "size": {"type": ["integer", "null"], "minimum": 0},
    "collection_date": {"type": ["string", "null"]},
    "preprocessing": {"type": "array", "items": {"type": "string"}},
    "deduplication": {"type": ["string", "null"]},
    "pii_handling": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
